# 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 git 에 올라가지 않는다)
#   cp .env.example .env

# Resend 대시보드 → API Keys 에서 만든 키 (re_ 로 시작)
RESEND_API_KEY=

# 보내는 사람. Resend 에 도메인을 인증하기 전에는 onboarding@resend.dev 만 쓸 수 있고,
# 그때는 Resend 계정 주인의 메일 주소로만 보내진다. 도메인 인증 후 예: Saylo <no-reply@sayloorder.com>
MAIL_FROM=Saylo <onboarding@resend.dev>

# 관리자 계정. 서버에 관리자가 하나도 없을 때 처음 한 번 만든다 (아이디 영문·숫자 8~20자, 비밀번호 8자 이상).
# 비워 두면 개발 중에는 adminuser / admin1234 가 만들어지고, 운영(Docker)에서는 관리자가 만들어지지 않는다
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 운영 배포(deploy/docker-compose.prod.yml)에서 HTTPS 인증서를 받을 도메인. 로컬 개발·docker compose(:8080)에서는 안 쓴다
DOMAIN=sayloorder.com
